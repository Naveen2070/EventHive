<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="002" author="you">
        <createTable tableName="roles">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="created_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_by" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueDate="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueDate="CURRENT_TIMESTAMP"/>
            <column name="deleted_at" type="TIMESTAMP"/>
        </createTable>

        <!-- Seed roles -->
        <insert tableName="roles">
            <column name="name" value="SUPER_ADMIN"/>
            <column name="created_by" valueNumeric="0"/>
            <column name="updated_by" valueNumeric="0"/>
        </insert>

        <insert tableName="roles">
            <column name="name" value="ADMIN"/>
            <column name="created_by" valueNumeric="0"/>
            <column name="updated_by" valueNumeric="0"/>
        </insert>

        <insert tableName="roles">
            <column name="name" value="USER"/>
            <column name="created_by" valueNumeric="0"/>
            <column name="updated_by" valueNumeric="0"/>
        </insert>

        <insert tableName="roles">
            <column name="name" value="ORGANIZER"/>
            <column name="created_by" valueNumeric="0"/>
            <column name="updated_by" valueNumeric="0"/>
        </insert>

    </changeSet>

</databaseChangeLog>
