<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           http://www.liquibase.org/xml/ns/dbchangelog
           http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

        <changeSet id="005" author="you">
            <createTable tableName="bookings">
                <column name="id" type="BIGINT" autoIncrement="true">
                    <constraints primaryKey="true" nullable="false" primaryKeyName="pk_bookings"/>
                </column>
                <column name="user_id" type="BIGINT">
                    <constraints nullable="false"/>
                </column>
                <column name="event_id" type="BIGINT">
                    <constraints nullable="false"/>
                </column>
                <column name="status" type="VARCHAR(50)">
                    <constraints nullable="false"/>
                </column>

                <column name="created_by" type="BIGINT">
                    <constraints nullable="false"/>
                </column>
                <column name="updated_by" type="BIGINT">
                    <constraints nullable="false"/>
                </column>
                <column name="deleted_by" type="BIGINT">
                    <constraints nullable="true"/>
                </column>
                <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                    <constraints nullable="false"/>
                </column>
                <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                    <constraints nullable="false"/>
                </column>
                <column name="created_at" type="TIMESTAMP" defaultValueDate="CURRENT_TIMESTAMP"/>
                <column name="updated_at" type="TIMESTAMP" defaultValueDate="CURRENT_TIMESTAMP"/>
                <column name="deleted_at" type="TIMESTAMP"/>
            </createTable>

            <!-- Foreign keys with names -->
            <addForeignKeyConstraint baseTableName="bookings" baseColumnNames="user_id"
                                     referencedTableName="app_users" referencedColumnNames="id"
                                     constraintName="fk_bookings_user"
                                     onDelete="CASCADE"/>

            <addForeignKeyConstraint baseTableName="bookings" baseColumnNames="event_id"
                                     referencedTableName="events" referencedColumnNames="id"
                                     constraintName="fk_bookings_event"
                                     onDelete="CASCADE"/>
        </changeSet>
</databaseChangeLog>