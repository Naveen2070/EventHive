<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

        <changeSet id="003" author="you">
            <createTable tableName="user_roles">
                <column name="user_id" type="BIGINT">
                    <constraints nullable="false"/>
                </column>
                <column name="role_id" type="BIGINT">
                    <constraints nullable="false"/>
                </column>

                <column name="created_by" type="BIGINT">
                    <constraints nullable="false"/>
                </column>
                <column name="updated_by" type="BIGINT">
                    <constraints nullable="false"/>
                </column>
                <column name="deleted_by" type="BIGINT">
                    <constraints nullable="true"/>
                </column>
                <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                    <constraints nullable="false"/>
                </column>
                <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                    <constraints nullable="false"/>
                </column>
                <column name="created_at" type="TIMESTAMP" defaultValueDate="CURRENT_TIMESTAMP"/>
                <column name="updated_at" type="TIMESTAMP" defaultValueDate="CURRENT_TIMESTAMP"/>
                <column name="deleted_at" type="TIMESTAMP"/>
            </createTable>

            <!-- Composite primary key with a name -->
            <addPrimaryKey tableName="user_roles" columnNames="user_id,role_id" constraintName="pk_user_roles"/>

            <!-- Foreign key for user_id -->
            <addForeignKeyConstraint baseTableName="user_roles" baseColumnNames="user_id"
                                     referencedTableName="app_users" referencedColumnNames="id"
                                     constraintName="fk_userroles_user"
                                     onDelete="CASCADE"/>

            <!-- Foreign key for role_id -->
            <addForeignKeyConstraint baseTableName="user_roles" baseColumnNames="role_id"
                                     referencedTableName="roles" referencedColumnNames="id"
                                     constraintName="fk_userroles_role"
                                     onDelete="CASCADE"/>
        </changeSet>
</databaseChangeLog>
